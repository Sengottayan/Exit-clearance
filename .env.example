# =============================================================================
# REQUIRED: Copy this file to artifacts/web/.env.local and fill in your keys
# =============================================================================
# Get Clerk keys: https://dashboard.clerk.com/last-active?path=api-keys
# Get Supabase keys: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk URL Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eweqweq.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=werwe9.YOUR_SERVICE_ROLE_KEY
